# Normalise line endings on checkout so the .rpy files stay readable.
* text=auto

*.rpy   text eol=lf
*.rpyc  binary
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.fnt   text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

*.png   binary
*.ico   binary
*.wav   binary
*.ogg   binary
*.wad   binary