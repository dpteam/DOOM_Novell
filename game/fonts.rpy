    for _name, _info in FONT.items():
        for _bold in (False, True):
            for _italics in (False, True):
                renpy.register_bmfont(
                    _info["file"],
                    _info["size"],
                    _bold,
                    _italics,
                    filename=_info["file"],
                )

    ## Keep text shaping simple and predictable for the pixel fonts.
    config.font_hinting = { "DejaVuSans.ttf": True }