################################################################################
## Fonts
##
## Every font in the game is a bitmap font generated by tools/build_assets.py:
##
##   doom1/doom2/doom3 - the STCFN glyphs from the IWAD, magnified 2x/4x/8x
##   cyr20..cyr44      - anti-aliasing-free rasterisations of a TTF, needed
##                       because the stock DOOM font has no Cyrillic at all
##
## Bitmap fonts are registered per (name, size, bold, italics).  We register
## the four bold/italic combinations for each entry so that a stray `bold True`
## cannot turn into "Could not find font" in the middle of a scene.
################################################################################

init -100 python:

    import json

    def _load_font_table():
        with renpy.open_file("fonts/fonts.json") as f:
            return json.loads(f.read().decode("utf-8"))

    # name -> {file, size, line_height, base}
    FONT = _load_font_table()

    def font_size(name):
        """The only size at which this bitmap font can be drawn."""
        return FONT[name]["size"]

