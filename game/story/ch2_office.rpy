################################################################################
## Глава 2 — Второй этаж
################################################################################

label ch2_office:

    scene bg office
    with Fade(0.4, 0.2, 0.6)
    play music mus("office") fadein 1.0

    "Второй этаж выглядел как первый, только с более честными намерениями."

    show imp talk at stage_left
    with dissolve
    imp "Я всё объясню."
    me "Объясни."
    imp "Принтер печатал сорок страниц в минуту. Я печатаю четыре. Я почувствовал конкуренцию."
    imp "Это не поджог. Это оптимизация узкого места."

    $ remember("imp")

    show imp neutral
    me "Ты сжёг принтер."
    imp "Технически принтер сжёг себя сам. Я только создал условия."
    imp "Как менеджмент."

    "Из-за стола поднялся Роман. Роман был скелетом в бронежилете и с ракетницей, которую он ласково называл «инструментом эскалации»."

    show revenant neutral at stage_right
    with dissolve

    $ remember("rev")

    rev "Тикет 4471. «Принтер не печатает». Приоритет: критический. Автор: стажёр."
    rev "Я перезагрузил принтер. Принтер перезагрузил меня."
    me "Ты живой?"
    rev "Я поддерживаемый. Это не то же самое, но зато без отпусков."

    show revenant angry
    rev "И вот теперь он горит. А знаете, что хуже горящего принтера?"
    me "Что?"
    rev "Горящий принтер, который продолжает печатать отчёты."

    "Принтер действительно печатал. Из лотка выходили листы, уже обугленные по краям. На каждом было написано: «КВАРТАЛЬНЫЙ ОТЧЁТ. КОПИЯ 14»."

    show imp talk at stage_left
    imp "Видите? Он справляется. Я же говорил."

    call the_printer_joke


label the_printer_joke:

    menu:
        "Потушить огонь.":
            $ mercy += 1
            jump ch2_extinguish

        "Добить принтер из дробовика.":
            jump ch2_shoot_printer

        "Дать Игнату ещё бумаги.":
            $ promises += 1
            $ mercy += 1
            jump ch2_more_paper


label ch2_extinguish:

    "Я взял огнетушитель. На нём была наклейка: «ПРОВЕРЕН 1994». Рядом другая: «ФОРМАЛЬНО ГОДЕН»."
    "Огонь погас. Принтер задымился, но остался жив и, что хуже, остался при исполнении."
    play sound sfx("item")
    $ hp = min(100, hp + 5)

    show imp neutral at stage_left
    imp "Вы потушили мою оптимизацию."
    me "Я потушил пожар."
    imp "Это вопрос терминологии. В отчёте я напишу «вмешательство в процесс»."

    jump ch2_boris_dies


label ch2_shoot_printer:

    play sound sfx("shotgun")
    with hpunch
    $ spend_ammo(2)
    $ add_kill(1, "squish")

    "Я выстрелил в принтер."
    "Принтер умер. Достойно, с достоинством, разбрызгивая тонер."

    show revenant talk at stage_right
    rev "Спасибо. Он был плохим коллегой."
    rev "Я закрою тикет как «решено». И заведу новый: «уничтожение корпоративного имущества»."
    me "На кого?"
    rev "На вас. Но вы не переживайте: я поставлю низкий приоритет. Лет на пять."

    "Бумаги стало меньше. Проблем — столько же."

    jump ch2_boris_dies


label ch2_more_paper:

    me "Игнат. Вот тебе бумага."
    show imp angry at stage_left
    imp "Спасибо!"
    "Он бросил в огонь пачку. Огонь обрадовался."
    "Через минуту горел уже не принтер, а весь угол. Угол был не против: в нём давно не убирали."

    show revenant angry at stage_right
    rev "Вы понимаете, что теперь это пожар категории «Б»?"
    me "Это уже прогресс. Вчера была категория «всё плохо»."
    rev "Мне нравится ваш подход. Он ужасен, но мне нравится."

    $ add_kill(1, "fire")

    "В огне что-то взорвалось. Это был чей-то кулер. Кулер не был человеком, но его всё равно жалко."

    jump ch2_boris_dies


label ch2_boris_dies:

    play sound sfx("squish")
    with hpunch

    "Что-то упало с потолка. Точнее, кто-то. Точнее, Борис."

    show boris dead at stage_center
    with dissolve

    me "Борис!"
    boris "Я в порядке."
    me "Ты разорван пополам."
    boris "Это вертикальное положение. Я в порядке."

    show boris pain at stage_center
    boris "Слушай. Слушай, это важно."
    me "Говори."
    boris "У них там, наверху, в тронном зале... Кибердемон. Он не менеджер."
    boris "Он... он ещё хуже. Он директор."

    me "И что он хочет?"
    boris "Отчёт. Квартальный."

    hide boris
    with dissolve

    "Борис умер. В этот раз — с соблюдением всех формальностей."

    show imp neutral at stage_left
    imp "Смотрите, он оставил пропуск. На третий этаж."
    me "Пропуск на третий этаж. Там же ад."
    imp "По пропуску — да. Без пропуска пришлось бы через вентиляцию, а там уборщик."
    me "Уборщик?"
    imp "Он очень привязан к вентиляции."

    $ remember("pain")

    "Из вентиляции донеслось негромкое, но очень уверенное рычание."

    call chapter(3, "Адский опенспейс", "Здесь не убивают. Здесь оптимизируют присутствие.", "map15")

    jump ch3_hell