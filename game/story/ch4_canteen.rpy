################################################################################
## Глава 4 — Столовая
################################################################################

label ch4_canteen:

    scene bg canteen
    with Fade(0.45, 0.25, 0.6)
    play music mus("office") fadein 1.0

    "Столовая пахла так, будто кто-то готовил ужин и одновременно сжигал улики."

    show mancubus neutral at stage_right
    with dissolve

    cook "Белковый день."
    me "Что в котле?"
    cook "Белок."
    me "А конкретнее?"
    cook "Конкретика — это отдел качества. Я — отдел количества."

    $ remember("cook")

    cook "Берите. Сегодня с утра в меню был Борис, но он ушёл, поэтому пришлось импровизировать."
    me "Импровизировать из чего?"
    cook "Из того, что не дожило до обеда. Это, кстати, самая честная категория продуктов."

    "Я взял ложку. Ложка была тёплой. Я решил не уточнять, почему."

    show lost talk at stage_left
    with dissolve

    lost "Всем приятного аппетита! Сегодня прекрасный день!"
    me "Сегодня конец света."
    lost "И это тоже прекрасно! Всё к лучшему!"

    $ remember("lost")

    "Душа светилась энтузиазмом и летала по столовой, ударяясь о стены на радостях."

    lost "Знаете, что мне нравится в нашей корпоративной культуре? Она не оставляет выбора!"
    lost "Это очень... структурирует!"

    play sound sfx("fire")
    "Душа врезалась в колонну, вспыхнула и полетела дальше. Улыбка осталась на месте."

    show lost neutral
    lost "Видите? Даже это к лучшему."

    show pain neutral at stage_center
    with dissolve

    "Из-под стола вылезло нечто маленькое, круглое и крайне гордое собой."

    pain "Я сын директора."
    me "Кибердемона?"
    pain "Да. Папа сказал, что я тоже акционер. У меня один процент."
    me "Один процент чего?"
    pain "Боли."

    $ remember("pain")

    "Ребёнок выдохнул. Из него вылетели три маленькие души и начали биться о светильники."

    pain "Это мои идеи. Они летают."

    $ take_damage(8, "player_pain")

    "Одна из идей врезалась мне в шлем. Идея была горячей."

    show pain angry at stage_center
    pain "Ты обидел мою идею."
    me "Твоя идея обидела меня первым."
    pain "Так не считается. Я ребёнок."

    menu:
        "Извиниться перед ребёнком.":
            $ mercy += 1
            $ promises += 1
            jump ch4_apologize

        "Пристрелить летающие идеи.":
            jump ch4_shoot_ideas

        "Предложить ребёнку конфету из аптечки.":
            $ mercy += 1
            $ hp = min(100, hp + 5)
            jump ch4_bribe


label ch4_apologize:

    me "Извини. Я не хотел обидеть твою идею."
    show pain neutral at stage_center
    pain "Правда?"
    me "Правда."
    pain "Тогда я скажу папе, что ты хороший. Он тебя, может, не уволит."
    me "А может?"
    pain "Может, уволит. Он непредсказуемый. У него ракета вместо руки."

    "Ребёнок ушёл, оставив после себя запах серы и детской непосредственности."

    $ remember("spider")
    jump ch4_server


label ch4_shoot_ideas:

    play sound sfx("shotgun")
    with hpunch

    $ spend_ammo(3)
    $ add_kill(3, "squish")

    "Три выстрела. Три идеи. Ни одна не выжила."

    show pain pain at stage_center
    pain "Ты убил мои идеи."
    me "Технически они уже были мёртвыми. Как и всё в этом здании."
    pain "Это не аргумент. Это диагноз."

    "Ребёнок заплакал. Из него полетели новые идеи, теперь с ещё большей скоростью."

    $ take_damage(6)

    pain "ПОЖАЛУЙСТА! Теперь горит и он!"

    jump ch4_server


label ch4_bribe:

    me "Держи. Стимулятор. Он как конфета, только потом немного болит."
    show pain neutral at stage_center
    pain "Как настоящая корпоративная конфета."
    me "Именно."

    play sound sfx("item")

    "Ребёнок съел стимулятор вместе с упаковкой. Его глаза загорелись. Буквально. Пришлось вызвать Арахну, чтобы она завела тикет."

    jump ch4_server


label ch4_server:

    hide pain
    hide lost
    hide mancubus
    with dissolve

    scene bg server
    with Fade(0.4, 0.25, 0.6)
    play music mus("chase") fadein 1.0

    "Серверная была единственным местом в здании, где было тихо. Здесь никто не кричал. Здесь гудели вентиляторы и пахло перегретым железом."

    show spider neutral at stage_right
    with dissolve

    spider "Вы опоздали."
    me "На сервер?"
    spider "На встречу с будущим. Оно у нас в 15:00."

    $ remember("spider")

    spider "Я Паучиха. Технический директор. Смотрю в будущее, вижу бэклог."
    spider "Архитектура — это просто нити. Тяните за правильную — и всё здание пойдёт за вами."

    me "А если потянуть не за ту?"
    spider "Тогда пойдёт только ваша карьера."

    show arachno neutral at stage_left
    with dissolve

    archn "Не слушайте её. Она оптимистична, потому что у неё восемь глаз и все смотрят в разные стороны."

    $ remember("arachno")

    archn "Я Арахна. QA. У меня к вам тридцать два бага."
    me "На меня?"
    archn "Первый: вы живы. Второй: вы вооружены. Третий: вы улыбаетесь, и это не предусмотрено спецификацией."

    show arachno talk
    archn "Не переживайте. Я поставлю им приоритет «низкий»."
    me "Спасибо."
    archn "И срок — «когда-нибудь». У нас так принято."

    show spider angry at stage_right
    spider "Арахна, не пугайте гостя. Он нам ещё нужен."
    spider "Сержант. У меня есть предложение. Я закрою все ваши баги."

    me "В чём подвох?"
    spider "Подвох в том, что вы станете нитью. Но с хорошей зарплатой и медицинским... чего-то."

    menu:
        "Согласиться стать нитью.":
            $ promises += 1
            jump ch4_accept

        "Отказаться и идти к директору.":
            jump ch4_refuse

        "Спросить Арахну, что она думает.":
            jump ch4_ask_qa


label ch4_accept:

    me "Я согласен."
    show spider talk at stage_right
    spider "Мудро. Держите бейдж. Теперь вы часть архитектуры."
    me "А что я буду делать?"
    spider "Тянуть."

    $ ammo += 10
    play sound sfx("item")

    "Она вложила мне в руки десять патронов. Восемь глаз смотрели на меня с профессиональным одобрением."

    jump ch4_after


label ch4_refuse:

    me "Я дойду до директора сам."
    show spider angry at stage_right
    spider "До директора доходят только те, кто не читал техническую документацию."
    me "Я не читал."
    spider "Тогда доходите. Но потом не говорите, что вас не предупреждали. Я всё записала. У меня восемь журналов."

    "Паучиха отступила в тень. Тень была частью её архитектуры."

    jump ch4_after


label ch4_ask_qa:

    me "Арахна. Что ты думаешь?"
    show arachno talk at stage_left
    archn "Как QA — что это плохая идея."
    archn "Как сотрудник — что это единственная идея, которая у нас есть."
    archn "Как паук — что нить всё равно оборвётся, но об этом напишут в постмортеме."

    me "И что мне выбрать?"
    archn "То, о чём вы будете жалеть меньше. У нас тут все так работают."

    $ mercy += 1

    jump ch4_after


label ch4_after:

    show arachno neutral at stage_left
    archn "Кстати. Директор ждёт вас в тронном зале. И у него плохое настроение."
    me "Насколько плохое?"
    archn "Он попросил принести ему кофе. Кофе закончился в 1994-м."

    show spider neutral at stage_right
    spider "Совет напоследок. Он не любит, когда перебивают."
    spider "И не любит, когда не перебивают."
    spider "И вообще он не любит."

    hide arachno
    hide spider
    with dissolve

    "Дверь в тронный зал открылась сама. Она открывалась сама уже тридцать лет и ни разу не проходила техобслуживание."

    call chapter(5, "Тронный зал", "Годовой отчёт. Смертельная доза.", "map30")

    jump ch5_throne