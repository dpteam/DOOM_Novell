################################################################################
## Глава 1 — Приёмная
################################################################################

label ch1_hr:

    scene bg landing
    with Fade(0.4, 0.2, 0.6)
    play music mus("map") fadein 1.0

    "ФОБОС. ОБЪЕДИНЁННАЯ АЭРОКОСМИЧЕСКАЯ КОРПОРАЦИЯ."
    "Понедельник. 09:14 по корпоративному времени, которое никто не выставил."

    narr "Меня зовут... впрочем, неважно. В табеле я записан как «Сержант, отдел ликвидации биологических угроз»."
    narr "Отдел сократили в прошлый вторник. Остался один сотрудник — я. И один принтер, который никто не выключил."

    show boris neutral at stage_left
    with dissolve

    boris "Ты опоздал на девять минут."
    me "Ты умер в понедельник."
    boris "Это считается прогулом."
    boris "Я четырнадцать раз умирал на этом этаже и ни разу не получил выговор. Знаешь почему?"

    me "Потому что ты мёртв?"

    show boris talk
    boris "Потому что я правильно оформлял отсутствие."
    boris "Форма 4-П. Посмертная переработка. Заполняется до того, как тебя разорвут. Иначе — прогул."

    $ remember("boris")

    narr "Борис был хорошим сотрудником. В том смысле, что он всегда был на месте. Даже когда его не было целиком."

    show boris neutral
    me "А демоны?"
    boris "Захватили второй этаж. Требуют профсоюз."
    me "Демоны требуют профсоюз."
    boris "И кофемашину. Но кофемашина — это уже наглость."
    boris "И, если честно, они просят не стрелять им в спину во время планёрки. Это, я считаю, разумно."

    "Где-то за стеной что-то взорвалось. Стена выдержала. Стена была из стали."

    show boris angry
    boris "Всё. Я на встречу."
    me "Ты не можешь идти на встречу. У тебя нет нижней половины."
    boris "Это обсуждаемо."

    hide boris
    with dissolve

    "Борис ушёл. Точнее, уполовинился в сторону лестницы."

    ## --- HR появляется ---

    play sound sfx("fire")
    show caco neutral at stage_right
    with dissolve

    caco "Доброе утро! Вы новый директор по урегулированию?"
    me "Я сержант."
    caco "Отлично. Значит, вам точно понравится наш подход к конфликтам."
    caco "Я Алексей. Эйчар. Если вам кажется, что я парю над проблемой — вам не кажется."

    $ remember("caco")

    narr "Алексей улыбался примерно третьим ртом. Остальными двумя он дышал."

    show caco talk
    caco "У нас небольшая формальность. Форма 4-П, согласие на посмертную переработку."
    caco "Тут галочка «согласен», тут галочка «очень согласен», и подпись кровью."
    me "Кровью?"
    caco "Можно ручкой. Но кровью быстрее, и у нас есть норматив."

    menu:
        "Подписать форму.":
            $ promises += 1
            $ mercy += 1
            jump ch1_sign

        "Застрелить Алексея.":
            jump ch1_shoot

        "Спросить про профсоюз.":
            jump ch1_union


label ch1_sign:

    me "Где подписать?"
    show caco neutral
    caco "Вот здесь. И здесь. И на обороте — там согласие на переработку в выходные, которые начнутся после смерти."
    me "А если я не умру?"
    caco "Тогда форма просто не понадобится. Корпорация предусмотрела оба варианта."
    caco "Вы удивительно сговорчивы. Обычно в вашем отделе все стреляют."

    $ hp = min(100, hp + 10)
    narr "Я поставил подпись. Кровью. Ручки не было — ручка ушла вместе с отделом кадров."
    jump ch1_after


label ch1_shoot:

    play sound sfx("shotgun")
    with hpunch
    $ spend_ammo(1)
    $ add_kill(1, "squish")

    "Выстрел в упор. Алексей исчез."
    "Через полторы секунды Алексей появился снова. С другой стороны. Целый, свежий, с папкой."

    show caco angry at stage_right
    with dissolve
    caco "У нас три дублёра и один подрядчик. Стреляйте, если вам от этого легче."
    caco "Только предупреждаю: каждая смерть сотрудника — это отдельный тикет. Тикеты закрываю я."

    me "То есть я стреляю, а бумаги становятся больше?"
    caco "Добро пожаловать в корпоративную культуру."

    narr "Я посчитал патроны. Их стало меньше. Бумаг — больше. Математика была на стороне Алексея."
    jump ch1_after


label ch1_union:

    me "Расскажите про профсоюз."
    show caco talk
    caco "А, вы слышали. Это инициатива снизу. Снизу — в буквальном смысле, они пришли из подвала."
    caco "Демоны хотят: коллективный договор, фиксированный обед и запрет на внезапные телепорты в рабочие часы."
    me "И что вы им ответили?"
    caco "Что телепорт — это легальная форма перемещения, а обед — форма мотивации."

    $ promises += 1
    $ mercy += 1

    narr "Алексей сказал это так мягко, что я почти поверил, будто обед — это привилегия."
    narr "Почти."

    show caco neutral
    caco "Вы, кстати, тоже можете вступить. Взносы — один литр крови в квартал."
    me "У меня нет столько."
    caco "Значит, будете платить частями."

    jump ch1_after


label ch1_after:

    show caco neutral
    caco "Ладно, оставим формальности. Вас ждут на втором этаже."
    caco "Там небольшое происшествие: стажёр поджёг принтер, айтишник объявил принтеру войну, а ваш коллега Борис... снова."
    me "Снова что?"
    caco "Снова на встрече."

    hide caco
    with dissolve

    "Алексей улетел. Бумаги остались. Бумаги всегда остаются."

    $ ammo += 8

    narr "В ящике стола лежал дробовик и восемь патронов. Дробовик был корпоративной собственностью, поэтому лежал с инвентарным номером."

    call chapter(2, "Второй этаж", "Пожар — это тоже инцидент. Оформите его.", "map02")

    jump ch2_office