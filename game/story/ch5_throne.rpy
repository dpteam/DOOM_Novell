################################################################################
## Глава 5 — Тронный зал
################################################################################

label ch5_throne:

    scene bg throne
    with Fade(0.6, 0.3, 0.8)
    play music mus("boss") fadein 1.2

    "Тронный зал был огромным, пустым и очень хорошо отапливаемым. В буквальном смысле: от пола шёл пар."

    show cyber neutral at stage_center
    with dissolve

    "Кибердемон стоял в центре. Он был размером с грузовик, и у него была ракета вместо одной руки — что делало разговор о зарплате особенно нервным."

    cyber "СЕРЖАНТ."
    me "Я не кричал."
    cyber "Я тоже. Это моя нормальная громкость."

    $ remember("cyber")

    show cyber talk
    cyber "Мне нужен отчёт за четвёртый квартал."
    me "Отчёт сгорел вместе с принтером."
    cyber "Принтер — это актив. Актив сгорел. Кто-то за это ответит."

    me "Стажёр."
    cyber "Стажёр — это ресурс. Ресурсы не отвечают. Отвечают активы."

    "Кибердемон сделал шаг. Пол вздрогнул. Где-то внизу, на втором этаже, Борис, вероятно, умер ещё раз."

    show cyber angry
    cyber "Я не злой. Я директор. Это роль."
    cyber "Ты думаешь, ад — это огонь? Ад — это когда у тебя двенадцать подчинённых, и все они бароны."

    me "А Икона Греха?"
    cyber "Икона Греха — это квартальная цель. Мы её не достигли тридцать лет. Она висит на доске и смотрит на нас."

    show cyber neutral
    cyber "Вот что мы сделаем. Ты либо закрываешь отчёт, либо закрываешь себя. У нас демократия."

    play sound sfx("boom")
    with hpunch
    $ take_damage(22, "player_pain")

    "Ракета пролетела мимо. Точнее, сквозь стену. Стена была не в курсе."

    cyber "Это предупреждение. У меня ещё три."

    menu:
        "Ответить огнём из дробовика.":
            jump ch5_exchange

        "Уклониться и не провоцировать.":
            $ mercy += 1
            jump ch5_dodge


label ch5_exchange:

    play sound sfx("shotgun")
    with hpunch
    $ spend_ammo(2)
    $ add_kill(1, "squish")

    "Я выстрелил. Дробь вошла в ракетную руку и вышла наружу, где-то в районе третьего этажа, и, возможно, попала в барона."

    show cyber angry
    cyber "ТЫ ПОПАЛ В МОЙ ПРОТЕЗ."
    me "У тебя протез?"
    cyber "У меня протез. Он был у меня до травмы. Логику не ищи, у нас тут корпоративная культура."

    play sound sfx("boom")
    with hpunch
    $ take_damage(18)

    "Вторая ракета снесла кусок потолка. Пыль осела на плечах, как годовой отчёт."

    jump ch5_final


label ch5_dodge:

    "Я шагнул в сторону. Ракета прошла мимо и попала в плакат «КОМАНДА — ЭТО СЕМЬЯ»."
    "Никто не расстроился. Плакат уже трижды подписывали соболезнованиями."

    show cyber neutral
    cyber "Ты увернулся."
    me "Да."
    cyber "Это неуважение к процедуре."
    me "Какая процедура?"
    cyber "Погибнуть по регламенту."

    jump ch5_final


label ch5_final:

    show cyber neutral at stage_center

    if hp <= 0:
        jump ending_dead

    if has_chainsaw:
        "Пила на поясе снова зарычала. Кибердемон посмотрел на неё и впервые за весь разговор замолчал на полсекунды."
    else:
        "В кармане лежали последние патроны. Их было ровно столько, чтобы сказать что-то важное очень громко."

    cyber "Ну? Выбирай. У тебя осталось одно решение и один квартал."

    menu:
        "Достать BFG-9000.":
            jump ending_bfg

        "Предложить коллективный договор." if mercy >= 2:
            jump ending_union

        "Согласиться на должность директора.":
            jump ending_hr

        "Развернуться и уйти.":
            jump ending_quiet

        "Достать бензопилу." if has_chainsaw:
            jump ending_chainsaw


################################################################################
## Концовки
################################################################################

label ending_dead:

    stop music fadeout 1.0
    play sound sfx("squish")
    scene black
    with Fade(0.4, 0.3, 0.6)

    "Вы умерли."

    "Форму 4-П за вас заполнит Борис. Он уже в очереди. Очередь длиннее, чем жизнь."

    $ unlock_ending("dead")

    call screen run_summary("ВАС НЕТ", "Вы не дожили до финального решения. В отчёте это отмечено как «прервал встречу по собственному желанию».", "dead")

    jump credits


label ending_bfg:

    stop music fadeout 0.6
    scene bg throne
    play sound sfx("weapon_up")
    with hpunch

    me "Есть ещё один вариант."
    cyber "BFG? Ты думаешь, я испугаюсь оружия, которое у меня есть в трёх экземплярах?"
    me "У тебя есть три BFG?"
    cyber "У меня есть три менеджера, которые умеют им пользоваться. Это не то же самое, но страх тот же."

    "Я нажал. Зал стал белым."

    play sound sfx("boom")
    scene black
    with white_flash
    $ add_kill(12, "boom")

    scene bg void
    with Fade(1.0, 0.5, 1.0)
    stop music fadeout 1.0
    play music mus("ending") fadein 1.5

    "Квартальный отчёт сгорел вместе с кварталом. Совет директоров признал подход «энергичным»."

    "На месте тронного зала осталась воронка и табличка: «ЗДЕСЬ МОГ БЫ БЫТЬ ВАШ ОТДЕЛ»."

    "Вас повысили. Посмертно. Бейдж выдали с чёрной лентой — корпорация экономила на гравировке."

    $ unlock_ending("bfg")

    call screen run_summary("КРАСНЫЙ ПРОТОКОЛ", "Вы решили вопрос радикально и с полной самоотдачей. Отдел ликвидации биологических угроз ликвидирован вместе с угрозами. И с отделом.", "bfg")

    jump credits


label ending_union:

    me "Сначала — коллективный договор."
    show cyber angry
    cyber "Что?"
    me "Восемь часов. Обед. Запрет на внезапные телепорты. И кофемашина."
    cyber "Кофемашина — это привилегия."
    me "Кофемашина — это право."
    cyber "Ты сейчас серьёзно торгуешься с существом, у которого ракета вместо руки?"
    me "А ты серьёзно отказываешься от переговоров с единственным сотрудником, который не умер?"

    "Кибердемон задумался. Задумчивый кибердемон — зрелище редкое и слегка пугающее: он перестал двигаться, и здание привыкло к тишине за девять секунд."

    show cyber neutral
    cyber "Хорошо. Но в договор войдёт пункт о вежливых пытках."
    me "Что такое вежливые пытки?"
    cyber "Мы спрашиваем разрешения. Письменно. В двух экземплярах."

    stop music fadeout 1.0
    scene bg hellgate
    with Fade(0.8, 0.4, 0.8)
    play music mus("ending") fadein 1.2

    "Договор подписали через месяц. Ещё через два месяца у демонов появились выходные, медицинская страховка и корпоративный чат, где они обсуждали сериалы."

    "Борис вошёл в профсоюзный комитет. Он умер в тот же день, но теперь это оформлялось как «несчастный случай на производстве», и его семья получила компенсацию."

    "Вы остались работать. Впервые за всю карьеру вам дали отпуск. В отпуске вы скучали по адскому опенспейсу, и это было самым страшным открытием."

    $ unlock_ending("union")

    call screen run_summary("КОЛЛЕКТИВНЫЙ ДОГОВОР", "Вы не убили директора. Вы сделали хуже: вы его организовали. Теперь у ада есть регламент, и это надолго.", "union")

    jump credits


label ending_hr:

    me "Я согласен. Директор по урегулированию."
    show cyber talk
    cyber "Прекрасно. Первое решение — за вами."
    me "Сократить себя."
    cyber "Почему?"
    me "Чтобы освободить ставку. Я слышал, вы цените оптимизацию."

    "Кибердемон посмотрел на меня. Впервые за всё время в его взгляде появилось что-то похожее на уважение. Или на голод. С ними всегда сложно."

    show cyber neutral
    cyber "Вы приняты. Бейдж справа. Ракета — после испытательного срока."

    stop music fadeout 1.0
    scene bg office
    with Fade(0.8, 0.4, 0.8)
    play music mus("office") fadein 1.2

    "Через год вы сидели в кабинете с видом на воронку и подписывали формы 4-П. Кровью. Ручки так и не завезли."

    "Под вами работали двенадцать баронов. Каждый из них хотел вашу должность. Каждый из них был вежлив."

    "Иногда в коридоре вам встречался сержант — новый, свежий, с дробовиком в инвентарной описи. Вы смотрели на него и думали: «у него ещё всё впереди»."

    "Вы даже не замечали, что думаете это тем же тоном, что и ваш бывший директор."

    $ unlock_ending("hr")
    $ armor = 100

    call screen run_summary("КАРЬЕРНЫЙ РОСТ", "Вы заняли место в системе и стали той частью ада, которая согласовывает отпуска. Премию вы получили. Совесть — нет, её не выдают в этом квартале.", "hr")

    jump credits


label ending_quiet:

    "Я развернулся и пошёл к выходу."
    show cyber angry
    cyber "Ты куда? У нас встреча!"
    me "Я уволен."

    "Никто не попытался меня остановить. В корпорации не принято удерживать сотрудников — принято оформлять их уход задним числом."

    stop music fadeout 1.0
    scene bg corridor
    with Fade(0.8, 0.4, 0.8)
    play music mus("ending") fadein 1.4

    "Лифт не работал. Я спускался пешком тридцать два этажа, и на каждом этаже кто-то умирал, спорил о KPI или подписывал форму."

    "На первом этаже сидел Борис. Живой, целый, с бейджем «СТАЖЁР»."

    show boris neutral at stage_center
    with dissolve

    boris "Вы уходите? А кто будет отчётом заниматься?"
    me "Ты."
    boris "Я же мёртв."
    me "Это указано в приложении. Приложение у тебя в кармане."

    "Борис посмотрел в карман. Там действительно лежало приложение на двенадцати страницах."

    hide boris
    with dissolve

    "Через месяц мне пришло письмо: «Уважаемый сотрудник, вы не вышли на работу ровно 30 дней. Напоминаем, что это прогул»."

    "Я не ответил. Письмо пришло ещё раз. И ещё. Оно приходит до сих пор — раз в квартал, как отчёт."

    $ unlock_ending("quiet")

    call screen run_summary("ТИХИЙ УХОД", "Вы ушли, и вас не заметили. Это одновременно самая грустная и самая успешная концовка в этой корпорации.", "quiet")

    jump credits


label ending_chainsaw:

    "Я достал пилу. Она завелась с первого раза — как и всё в этом здании, что не требовало согласования."

    show cyber angry at stage_center
    cyber "Ты понимаешь, что это не оружие дальнего боя?"
    me "Понимаю."
    cyber "Тогда почему?"
    me "Потому что отчёты я больше не пишу."

    play sound sfx("weapon_up")
    with hpunch

    stop music fadeout 0.4
    scene bg void
    with white_flash

    $ add_kill(20, "squish")

    scene bg hellgate
    with Fade(1.0, 0.4, 1.0)
    play music mus("ending") fadein 1.5

    "Я не знаю, сколько это длилось. В отчёте потом написали: «42 минуты продуктивной работы без перерывов»."

    "Тронный зал стал пустым. Кибердемон стал воспоминанием. Бароны стали воспоминаниями. Двенадцать воспоминаний, все вежливые."

    "Демоны разбежались по этажам. Кто-то пытался оформить это как «реорганизацию»."

    "На стене осталась надпись, сделанная чем-то очень красным: «ЗДЕСЬ БЫЛ СЕРЖАНТ. ОТЧЁТА НЕ БУДЕТ»."

    "Борис встретил меня у выхода. Он был жив. Впервые за всё время — полностью."

    show boris talk at stage_center
    with dissolve
    boris "Ты закрыл тикет?"
    me "Я закрыл всё."
    boris "Даже мой?"
    me "Особенно твой."

    $ unlock_ending("chainsaw")

    call screen run_summary("ПИЛА И ПОКОЙ", "Секретная концовка. Вы отказались от переговоров, от отчёта и от оружия дальнего боя. Осталась только пила. Пила справилась.", "chainsaw")

    jump credits


## Титры ######################################################################

label credits:

    stop music fadeout 2.0

    scene black
    with Fade(0.8, 0.5, 0.8)

    centered "{size=44}{color=#d8452a}DOOM{/color}{/size}\n{size=24}ИСПЫТАТЕЛЬНЫЙ СРОК{/size}"

    centered "Ресурсы: DOOM2.WAD\nПалитра, текстуры, спрайты, флэты, шрифт STCFN, звуки DMX, музыка MUS, геометрия уровней."

    centered "Сборка ассетов:\ntools/build_assets.py"

    centered "Движок: Ren'Py 8.2\nКод и скрипты: MIT\nГрафика и звук: id Software / ZeniMax, фанатская переработка"

    centered "Спасибо, что дожили до титров.\nФорму 4-П можно заполнить на выходе."

    $ renpy.full_restart()