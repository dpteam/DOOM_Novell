################################################################################
## Глава 3 — Адский опенспейс
################################################################################

label ch3_hell:

    scene bg hellhall
    with Fade(0.5, 0.3, 0.7)
    play music mus("hell") fadein 1.2

    "Третий этаж был отделан мрамором, кожей и чужими надеждами."

    narr "На стене висел плакат: «КОМАНДА — ЭТО СЕМЬЯ». Ниже, мельче: «Семья — это те, кого нельзя уволить»."

    show baron neutral at stage_right
    with dissolve

    baron "Сержант. Наконец-то. Присаживайтесь."
    me "Здесь нет стульев."
    baron "Это часть концепции. Стоя вы работаете на двенадцать процентов продуктивнее. Мы проверяли."

    $ remember("baron")

    baron "Я барон фон Гелл. Мидл-менеджмент. Отвечаю за синергию между отделами и за то, чтобы синергия никого не убивала."
    baron "Синергия иногда убивает. Но не по моей вине."

    show baron talk
    baron "Давайте сразу к делу. Вы понимаете, что мы не убиваем людей?"
    me "Вы разорвали Бориса пополам."
    baron "Мы сократили его присутствие. Это разные вещи, и в отчёте это разные строки."

    narr "Барон говорил медленно, вежливо и с абсолютной уверенностью в том, что слова важнее последствий."

    baron "У меня к вам предложение. Квартальный план. Подпишете — и я закрою глаза на двенадцать ваших нарушений."
    me "У меня нет двенадцати нарушений."
    baron "У вас есть двенадцать нарушений. Вы просто ещё не читали приложение."

    show archvile neutral at stage_left
    with dissolve

    "В воздухе запахло горелым. Не тем горелым, что от принтера. Тем, что от людей."

    $ remember("vile")

    vile "Извините. Я не помешала? У нас через минуту групповое занятие по выгоранию."
    baron "Вика, у нас разговор."
    vile "Всё, что не разговор о выгорании, — это тоже выгорание."
    vile "Я Вика. Коуч. Помогаю сотрудникам гореть правильно."

    show archvile talk
    vile "Выгорание — это когда ты перестал гореть. Профессиональное выгорание — когда ты перестал гореть, но продолжаешь работать."
    vile "Моя методика возвращает пламя."

    me "Возвращает?"

    "Вика повернулась к проходившему мимо стажёру. Стажёр загорелся. Стажёр был не против — он давно просил обратную связь."

    show archvile neutral
    vile "Видите? Искра."
    me "Он горит."
    vile "Он мотивирован. Это разные вещи, но в наших отчётах они совпадают."

    $ take_damage(5, "fire")
    narr "Мне тоже досталось немного искры. Пахло как на собеседовании."

    show demon angry at stage_center
    with dissolve

    "Из-под стола вылез корпоративный питомец. Девятьсот килограммов. У него были зубы там, где у собак обычно бывает морда."

    dog "Гав."
    baron "Он говорит «дедлайн»."
    dog "ГАВ."
    baron "Он говорит «вчера»."

    $ remember("dog")

    "Пёс сожрал стул. Стул был корпоративный. Никто не сказал ни слова."

    show baron talk at stage_right
    baron "Итак, план на квартал. Подписываете?"
    baron "Это чистая формальность. Как смерть."

    menu:
        "Подписать план.":
            $ promises += 1
            $ mercy += 1
            jump ch3_sign

        "Выстрелить в барона.":
            jump ch3_shoot_baron

        "Снять со стены бензопилу.":
            jump ch3_chainsaw


label ch3_sign:

    me "Где подписать?"
    show baron neutral at stage_right
    baron "Вот здесь. И здесь. И — внимание — здесь, где написано «согласен на обучение по методике Вики»."
    me "Это же не обучение. Это розжиг."
    baron "У нас это называется «интенсив»."

    $ hp = max(5, hp - 5)
    narr "Я подписал. В тот же момент у меня в кармане появился бейдж с надписью «ЦЕННЫЙ СОТРУДНИК»."
    narr "Под надписью мелким шрифтом: «ценность определяется при увольнении»."

    show archvile talk at stage_left
    vile "Поздравляю. Вы теперь горите."
    me "Я не горю."
    vile "Это пока. Пламя приходит изнутри. Или из моей руки."

    jump ch3_after


label ch3_shoot_baron:

    play sound sfx("shotgun")
    with hpunch

    $ spend_ammo(2)
    $ add_kill(1, "squish")

    "Я выстрелил барону в лицо. Лицо не изменилось. Барон продолжил говорить с той же скоростью, с которой начал, только без головы."

    show baron angry at stage_right
    baron "Это было неэффективно."
    me "Зато приятно."
    baron "Приятно — не метрика."
    baron "У нас двенадцать баронов. Один из них сейчас на встрече. Угадайте, кто займёт его место."

    "Голова барона докатилась до стены и остановилась. Она всё ещё говорила. У корпорации были очень устойчивые головы."

    $ ammo += 4
    narr "В кармане погибшего обнаружились четыре патрона и памятка «Как пережить увольнение». Памятка была на двух страницах. Обе — «не вы»."

    jump ch3_after


label ch3_chainsaw:

    "На стене висела бензопила. Под ней табличка: «РЕКВИЗИТ. НЕ ТРОГАТЬ. СЕРЬЁЗНО»."
    "Я тронул."

    $ has_chainsaw = True
    $ promises += 1

    play sound sfx("weapon_up")
    narr "Пила завелась с первого раза. Она была единственным сотрудником в этом здании, который работал без согласований."

    show baron angry at stage_right
    baron "Это нарушение техники безопасности!"
    me "Это оптимизация."
    baron "Вы не можете оптимизировать барона!"
    me "Я могу оптимизировать всё, что не защищено регламентом. Ваш регламент я съел в прошлой главе."

    show archvile neutral at stage_left
    vile "Мне нравится его подход. Он горит."
    baron "Вика, не поощряйте."
    vile "Я не поощряю. Я диагностирую."

    "Пила зарычала. Пёс зарычал в ответ. Они нашли общий язык быстрее, чем все остальные в этом здании."

    $ kills += 0

    jump ch3_after


label ch3_after:

    show baron neutral at stage_right
    baron "Ладно. Оставим формальности. Вас всё равно ждут выше."
    baron "Но сначала — столовая. У нас корпоративный обед, и он mandatory."
    me "Обязательный."
    baron "Именно. Пропуск обеда — это прогул. А прогул у нас приравнивается к смерти. Иногда буквально."

    hide baron
    hide archvile
    hide demon
    with dissolve

    $ remember("cook")
    $ remember("lost")
    $ remember("arachno")
    $ remember("spider")

    call chapter(4, "Столовая", "Белковый день. Опять.", "map07")

    jump ch4_canteen